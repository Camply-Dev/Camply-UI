{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"baseUrl": ".",
		"paths": {
			"@camply/ui": ["../src/index.ts"],
			"react": ["../node_modules/@types/react"],
			"react/*": ["../node_modules/@types/react/*"],
			"react-dom": ["../node_modules/@types/react-dom"],
			"react-dom/*": ["../node_modules/@types/react-dom/*"]
		}
	},
	"include": ["src"]
}
