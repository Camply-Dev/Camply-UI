{
	"name": "@camply/ui",
	"version": "0.1.0",
	"description": "Bibliothèque de composants React pour Camply",
	"type": "module",
	"workspaces": [
		"docs"
	],
	"license": "MIT",
	"author": "Camply",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Camply-Dev/Camply-UI.git"
	},
	"homepage": "https://github.com/Camply-Dev/Camply-UI#readme",
	"bugs": {
		"url": "https://github.com/Camply-Dev/Camply-UI/issues"
	},
	"keywords": [
		"react",
		"components",
		"ui",
		"camply"
	],
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css",
		"./icons": {
			"types": "./dist/lib/icons.d.ts",
			"import": "./dist/lib/icons.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"THIRD-PARTY-LICENSES.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "bun --cwd docs dev",
		"docs:build": "bun --cwd docs build",
		"build": "bun scripts/build.js",
		"typecheck": "tsc --noEmit && tsc --noEmit -p docs/tsconfig.json",
		"check": "biome check .",
		"fix": "biome check --write .",
		"sync": "bun scripts/sync-src-barrel.js",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"typescript": "^7.0.2"
	}
}
