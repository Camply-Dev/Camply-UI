{
	"name": "@camply/ui",
	"version": "0.1.0",
	"description": "Bibliothèque de composants React pour Camply",
	"type": "module",
	"license": "MIT",
	"author": "",
	"repository": {
		"type": "git",
		"url": ""
	},
	"keywords": [
		"react",
		"components",
		"ui",
		"camply"
	],
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./button": {
			"types": "./dist/button.d.ts",
			"import": "./dist/button.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "bun --cwd playground dev",
		"build": "tsup && bun scripts/post-build.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
		"check": "biome check .",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"lint:fix": "biome check --write .",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	}
}
