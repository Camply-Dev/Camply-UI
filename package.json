{
	"name": "@camply/ui",
	"version": "0.1.0",
	"description": "Bibliothèque de composants React pour Camply",
	"type": "module",
	"license": "MIT",
	"author": "",
	"repository": {
		"type": "git",
		"url": ""
	},
	"keywords": [
		"react",
		"components",
		"ui",
		"camply"
	],
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./styles.css": "./dist/index.css"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "bun --cwd playground dev",
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"lint:fix": "biome check --write .",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"tsup": "^8.5.0",
		"typescript": "^5.8.3"
	}
}
