{
	"name": "@camply/ui",
	"version": "0.4.0",
	"description": "Bibliothèque de composants React pour Camply",
	"type": "module",
	"workspaces": [
		"docs"
	],
	"license": "MIT",
	"author": "Camply",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Camply-Dev/Camply-UI.git"
	},
	"homepage": "https://github.com/Camply-Dev/Camply-UI#readme",
	"bugs": {
		"url": "https://github.com/Camply-Dev/Camply-UI/issues"
	},
	"keywords": [
		"react",
		"components",
		"ui",
		"camply"
	],
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json",
		"./styles.css": "./dist/styles.css",
		"./tokens.css": "./dist/tokens.css",
		"./icons": {
			"types": "./dist/lib/icons.d.ts",
			"import": "./dist/lib/icons.js"
		},
		"./*/styles.css": "./dist/components/*/*.css",
		"./*": {
			"types": "./dist/components/*/index.d.ts",
			"import": "./dist/components/*/index.js"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md",
		"THIRD-PARTY-LICENSES.md",
		"AI-CONTEXT.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "bun --cwd docs dev",
		"docs:build": "bun --cwd docs build",
		"build": "bun scripts/build.js",
		"typecheck": "tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p docs/tsconfig.json",
		"knip": "knip",
		"check": "biome check .",
		"fix": "biome check --write .",
		"sync": "bun scripts/sync-src-barrel.js",
		"prepublishOnly": "bun run build && bunx --bun publint@0.3.16 --strict",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"esbuild": "^0.28.1",
		"jsdom": "^30.1.0",
		"knip": "6.26.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"typescript": "7.0.2",
		"vitest": "3.2.4"
	}
}
