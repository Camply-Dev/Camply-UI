	},
	"scripts": {
		"dev": "bun --cwd docs dev",
		"docs:dev": "bun --cwd docs dev",
		"docs:build": "bun --cwd docs build",
		"build": "tsup && bun scripts/post-build.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p docs/tsconfig.json",
		"check": "biome check .",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"lint:fix": "biome check --write .",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
